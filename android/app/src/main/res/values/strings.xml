<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">Farbaek</string>
    <!-- launch_url comes from app/build.gradle.kts, so it carries the build number (ADR 0150, ADR 0193). -->
    <!-- The site this app may open full screen; the site names the app back in /.well-known/assetlinks.json. -->
    <string name="asset_statements" translatable="false">[{\"relation\": [\"delegate_permission/common.handle_all_urls\"], \"target\": {\"namespace\": \"web\", \"site\": \"https://www.farbaek.com\"}}]</string>
    <!-- Nearby (ADR 0193): plain sentences, as on the web. -->
    <string name="nearby_title">Nearby</string>
    <string name="nearby_channel">Nearby transfers</string>
    <string name="nearby_channel_description">Shows while this phone is visible to your computers or moving files with them.</string>
    <string name="nearby_ongoing_visible">Visible to your computers on this Wi-Fi.</string>
    <string name="nearby_ongoing_sending">Sending %1$s to %2$s.</string>
    <string name="nearby_ongoing_receiving">Receiving %1$s from %2$s.</string>
    <string name="nearby_limit_title">Nearby stopped for today</string>
    <string name="nearby_limit_body">Android lets apps move files in the background for six hours a day, and Nearby reached that. Open Nearby to carry on with the screen on.</string>
    <!-- Where shared text goes: the same address and fields as share_target in src/app/manifest.ts. -->
    <string name="share_target" translatable="false">{\"action\": \"https://www.farbaek.com/app/new\", \"method\": \"GET\", \"enctype\": \"application/x-www-form-urlencoded\", \"params\": {\"title\": \"title\", \"text\": \"text\", \"url\": \"url\"}}</string>
</resources>
