<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The Nearby screen (ADR 0193): one light theme on the web app's canvas, as everywhere in Farbaek. -->
    <style name="Theme.Farbaek.Nearby" parent="@android:style/Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:windowBackground">@color/canvas</item>
        <item name="android:statusBarColor">@color/canvas</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/ink_2</item>
    </style>
</resources>
