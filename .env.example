# Farbaek environment variables: NAMES ONLY. Never commit real values.
# Nothing below is read by the app yet. Each block lists the stage that starts using it.

# Stage 1: database and auth (Supabase project, see docs/adr/0005-auth-and-database.md)
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stage 1: email for trial reminders (provider not chosen yet)
EMAIL_PROVIDER_API_KEY=

# Stage 2: model provider (server-side only)
ANTHROPIC_API_KEY=

# Stage 2: sandbox provider (see docs/adr/0003-sandbox-provider.md)
SANDBOX_PROVIDER=
SANDBOX_API_KEY=

# Stage 8: payments. Billing stays "not_connected" until docs/billing/go-live.md is complete.
BILLING_MODE=not_connected
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
