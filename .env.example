# Farbaek environment variables: NAMES ONLY. Never commit real values.
# Each block says what reads it, or the stage that will start using it.

# Public origin used in sign-in email links. Required in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (read by src/server/supabase/config.ts). Find both under
# Project Settings > API Keys. The publishable key is safe in browsers.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase secret key (sb_secret_...). Required for every write
# (projects, tasks, task transitions): src/server/supabase/admin.ts. Without it
# the app is read-only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Read-only demo workspace with sample data. Only works when the Supabase
# variables above are NOT set, so it can never mix with real data.
FARBAEK_DEMO_APP=
# Admin console (/admin, ADR 0026): comma-separated emails allowed in, such as
# hello@farbaek.com. Unset or empty: nobody is an admin. The person must also
# sign in with that confirmed email, and SUPABASE_SECRET_KEY must be set.
FARBAEK_ADMIN_EMAILS=

# Office Space, the staff console (ADR 0032), on its own host such as
# officespace.farbaek.com (officespace.localhost:3000 locally). Unset: the
# office is off and its host answers 404. OFFICE_OWNER_EMAIL may become the
# first owner while the office has none; remove it once that's done.
OFFICE_HOST=
OFFICE_OWNER_EMAIL=

# Farbaek's own email (ADR 0060): it tells people when a build they started is
# ready and when its checks end. Off until SMTP_PASSWORD is set; the owner types
# it with scripts/vps/set-email-password.ps1. The rest default to Spacemail as
# hello@farbaek.com, the account sign-in emails use. Implicit TLS only (465).
SMTP_PASSWORD=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=
# Unused: kept until the old value is removed from the server.
EMAIL_PROVIDER_API_KEY=

# Signed ProofPacks (ADR 0062): an Ed25519 private key as base64 PKCS#8 DER.
# Made on the server by scripts/vps/set-signing-key.ps1 and never copied off it.
# Unset: nothing is signed, and evidence still proves its integrity by digest.
PROOFPACK_SIGNING_KEY=

# The whole platform's AI spend for one UTC day, in US dollars (ADR 0065).
# Unset means 20. "off" removes the cap. Past it, AI work pauses until midnight UTC.
AI_DAILY_LIMIT_USD=

# Where the owner's platform alerts go (ADR 0068): an email at 80% of the
# daily AI limit and when it's reached. Unset means OFFICE_OWNER_EMAIL, then
# hello@farbaek.com.
ALERT_EMAIL=

# Cloudflare Turnstile at sign-in (ADR 0067). The site key is public. Leave it
# empty to sign in without the check. Locally, Cloudflare's test key
# 1x00000000000000000000AA always passes; Supabase Auth needs the matching
# test secret for the check to be enforced.
TURNSTILE_SITE_KEY=

# AI providers for "Draft with AI" and change proposals (ADR 0009, ADR 0014):
# src/server/ai/. Server-side only; never prefix with NEXT_PUBLIC_. Set them
# with: pnpm setup:env, then type "ai". Without either key the AI buttons are
# shown as unavailable. Usage is billed to the key that's used.
#
# Claude (sk-ant-...), from platform.claude.com > API keys.
ANTHROPIC_API_KEY=
# Gemini, from aistudio.google.com > API Keys. On Google's free tier, prompts
# and responses may be used to improve Google's products; not on paid tiers.
GEMINI_API_KEY=
# Optional: a Gemini model id (default gemini-3.8-flash).
GEMINI_MODEL=
# Optional: "anthropic" or "gemini". Unset: Claude when its key is set,
# otherwise Gemini.
AI_PROVIDER=

# FARBAEK Sandbox (docs/sandbox/README.md, ADR 0013). Read by
# src/server/sandbox/config.ts. Without these, project code never runs:
# Farbaek stays in Review Only and says why. Set them with: pnpm setup:env,
# then type "sandbox". Never prefix any of these with NEXT_PUBLIC_.
#
# Runtime: "vercel" (Vercel Sandbox, ADR 0016) or "e2b" (self-hosted E2B Embed
# or E2B Cloud). Both run each session in its own Firecracker microVM.
SANDBOX_PROVIDER=
# Vercel Sandbox: an access token, with the team and project it belongs to.
# Use a Vercel account kept only for sandboxes: the token can manage its other
# projects. When Farbaek itself runs on Vercel, leave these empty and the
# platform's OIDC token is used.
SANDBOX_VERCEL_TOKEN=
SANDBOX_VERCEL_TEAM_ID=
SANDBOX_VERCEL_PROJECT_ID=
# Optional: a Vercel region such as fra1 (default iad1).
SANDBOX_VERCEL_REGION=
# E2B: server-only key for the runtime's API. Never passed into sandboxes.
E2B_API_KEY=
# Self-hosted runtime only: its domain (the SDK calls api.<domain>), or the
# full API URL for a plain-HTTP runtime on a private network.
E2B_DOMAIN=
E2B_API_URL=
# Set to the date pnpm sandbox:smoke passed on this deployment's runtime.
# Until then, sessions can't run code (Review Only).
SANDBOX_ISOLATION_VERIFIED_AT=
# The runtime's own longest session in minutes (E2B Cloud: 60 on Hobby;
# Vercel Sandbox: 45 on Hobby; both 1440 on Pro). Plans are capped to it.
# Unset: 45 for Vercel, 60 for E2B.
SANDBOX_RUNTIME_MAX_SESSION_MINUTES=
# Labels this deployment's sandboxes so cleanup never touches another
# environment sharing the same runtime account.
SANDBOX_DEPLOYMENT_ID=farbaek-local
# Previews (E2B only; off on Vercel Sandbox): a separate host for running apps, p-<id>.<domain>. Locally
# preview.localhost:3000 works in Chrome and Firefox; in production use a
# separate registrable domain with wildcard DNS and TLS.
SANDBOX_PREVIEW_DOMAIN=preview.localhost:3000
# Published sites' domain (<name>.<domain>, ADR 0029, ADR 0045). Without it, sites use
# SANDBOX_PREVIEW_DOMAIN. Set it alone to put sites live while previews stay off: sites get
# certificates on demand, previews need a wildcard certificate. Not a secret.
SITES_DOMAIN=
# The server's public IPv4 address, for people's own root domains (example.com) on published
# sites (ADR 0045): they point an A record here. Subdomains use a CNAME to sites.<site domain>
# instead. Leave empty to offer subdomains only. Not a secret.
SITES_TARGET_IP=
# 32+ random characters; signs preview links. Generate, never reuse.
SANDBOX_PREVIEW_SECRET=
# 32+ random characters; authorizes POST /api/internal/sandbox/sweep.
SANDBOX_CRON_SECRET=
# Optional image name overrides (defaults: farbaek-node-small, ... on E2B;
# vercel/sandbox/universal on Vercel Sandbox).
SANDBOX_IMAGE_NODE_SMALL=
SANDBOX_IMAGE_NODE_STANDARD=
SANDBOX_IMAGE_PYTHON_SMALL=
SANDBOX_IMAGE_PYTHON_STANDARD=

# Payments (ADR 0100). Billing stays "not_connected" until docs/billing/go-live.md is complete.
# "test" connects Dodo's test mode for the workspaces in BILLING_TEST_WORKSPACES (comma-separated ids); "live" is refused.
BILLING_MODE=not_connected
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
BILLING_TEST_WORKSPACES=
