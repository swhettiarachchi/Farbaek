# Farbaek environment variables: NAMES ONLY. Never commit real values.
# Each block says what reads it, or the stage that will start using it.

# Public origin used in sign-in email links. Required in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (read by src/server/supabase/config.ts). Find both under
# Project Settings > API Keys. The publishable key is safe in browsers.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase secret key (sb_secret_...). Required for every write
# (projects, tasks, task transitions): src/server/supabase/admin.ts. Without it
# the app is read-only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Read-only demo workspace with sample data. Only works when the Supabase
# variables above are NOT set, so it can never mix with real data.
FARBAEK_DEMO_APP=

# Stage 1: email for trial reminders (provider not chosen yet)
EMAIL_PROVIDER_API_KEY=

# Anthropic API key (sk-ant-...) for "Draft with AI" on intent contracts:
# src/server/ai/anthropic.ts. Server-side only; never prefix with NEXT_PUBLIC_.
# Without it the button is shown as unavailable. Usage is billed to this key.
ANTHROPIC_API_KEY=

# Stage 2: sandbox provider (see docs/adr/0003-sandbox-provider.md)
SANDBOX_PROVIDER=
SANDBOX_API_KEY=

# Stage 8: payments. Billing stays "not_connected" until docs/billing/go-live.md is complete.
BILLING_MODE=not_connected
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
