{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "farbaek-prod",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "start"
      ],
      "port": 3000
    },
    {
      "name": "farbaek-prod-si",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "start"
      ],
      "env": {
        "SANDBOX_PREVIEW_DOMAIN": "farbaek.si"
      },
      "port": 3000
    },
    {
      "name": "farbaek-office",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "start"
      ],
      "env": {
        "OFFICE_HOST": "officespace.localhost:3000"
      },
      "port": 3000
    },
    {
      "name": "farbaek-dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "farbaek-demo",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "scripts/start-demo.mjs"
      ],
      "port": 3000
    }
  ]
}
