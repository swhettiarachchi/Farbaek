# Farbaek's settings for self-hosted Supabase (ADR 0036). None of these is
# secret. scripts/vps/supabase-setup.sh writes them over the official
# defaults in /opt/farbaek/supabase/docker/.env; the secrets in that file are
# generated on the server by Supabase's own utils/generate-keys.sh and never
# printed. SMTP_PASS is typed in by the owner.

# Supabase's compose first, then Farbaek's override.
COMPOSE_FILE=docker-compose.yml:/opt/farbaek/app/deploy/vps/supabase/compose.farbaek.yaml

# The public address of the API (Caddy forwards /auth/v1 and /rest/v1 here).
SUPABASE_PUBLIC_URL=https://api.farbaek.com
API_EXTERNAL_URL=https://api.farbaek.com/auth/v1

# Where sign-in links may send people (kept in step with Supabase Cloud's settings).
SITE_URL=https://www.farbaek.com
ADDITIONAL_REDIRECT_URLS=https://www.farbaek.com/auth/callback,https://officespace.farbaek.com/sign-in,http://localhost:3000/**

# Email sign-in only: no phone sign-up, no anonymous users, addresses must be confirmed.
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false
ENABLE_ANONYMOUS_USERS=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false
JWT_EXPIRY=3600

# Email through Spacemail, as on Supabase Cloud (docs/stages/stage-5.md).
SMTP_ADMIN_EMAIL=hello@farbaek.com
SMTP_HOST=mail.spacemail.com
SMTP_PORT=465
SMTP_USER=hello@farbaek.com
SMTP_SENDER_NAME=Farbaek

STUDIO_DEFAULT_ORGANIZATION=Farbaek
STUDIO_DEFAULT_PROJECT=Farbaek
