# Farbaek's production settings on the VPS (docs/deploy/vps.md).
# Copied to /opt/farbaek/env/production.env (mode 600). The owner types the
# secret values on the server; they never go in the repo, a chat or a log.
# Values marked "set" are not secret and are already right.

# --- Public settings (set) ---
NEXT_PUBLIC_SITE_URL=https://www.farbaek.com
BILLING_MODE=not_connected
AI_PROVIDER=anthropic
FARBAEK_ADMIN_EMAILS=hello@farbaek.com
SANDBOX_DEPLOYMENT_ID=vps-production
OFFICE_HOST=officespace.farbaek.com
OFFICE_OWNER_EMAIL=info@farbaek.com

# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# --- AI (required for builds) ---
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- Sandboxes and previews (fill in when used) ---
SANDBOX_PROVIDER=
SANDBOX_VERCEL_TOKEN=
SANDBOX_VERCEL_TEAM_ID=
SANDBOX_VERCEL_PROJECT_ID=
SANDBOX_ISOLATION_VERIFIED_AT=
SANDBOX_PREVIEW_DOMAIN=
SANDBOX_PREVIEW_SECRET=
SANDBOX_CRON_SECRET=

# --- Email (when a provider is chosen) ---
EMAIL_PROVIDER_API_KEY=
# Farbaek's own email (ADR 0060): off until set; scripts/vps/set-email-password.ps1 sets it.
SMTP_PASSWORD=
# Signed ProofPacks (ADR 0062): made on the server by scripts/vps/set-signing-key.ps1.
PROOFPACK_SIGNING_KEY=
# The platform's daily AI limit in US dollars (ADR 0065); unset means 20.
AI_DAILY_LIMIT_USD=
# Turnstile's public site key for the sign-in check (ADR 0067); set by scripts/vps/set-turnstile.ps1.
TURNSTILE_SITE_KEY=
