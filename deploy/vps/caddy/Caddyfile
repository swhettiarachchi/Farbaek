# Farbaek's front door on the VPS (ADR 0035). Caddy gets and renews each
# certificate itself. The Host header passes through untouched, so
# src/proxy.ts decides what every name serves, exactly as before.
{
	email hello@farbaek.com
	# Published sites and people's own domains get their certificates on
	# first visit (ADR 0045), but only for names Farbaek says are live sites:
	# a live <name>.farbaek.si, or a verified custom domain whose site is live.
	on_demand_tls {
		ask http://app:3000/api/sites/tls-allowed
	}
}

www.farbaek.com, officespace.farbaek.com {
	# Desktop agent installers (ADR 0077), copied into /opt/farbaek/downloads on
	# the server. Names carry the version, so a file never changes once
	# published and can be cached for a year. The folder isn't listed.
	@downloads {
		host www.farbaek.com
		path /downloads/*
	}
	handle @downloads {
		uri strip_prefix /downloads
		root * /srv/downloads
		header Cache-Control "public, max-age=31536000, immutable"
		header X-Content-Type-Options nosniff
		header Content-Disposition attachment
		file_server
	}
	handle {
		reverse_proxy app:3000 {
			# While a deploy swaps the app container, hold requests for a moment instead of failing them.
			lb_try_duration 20s
			lb_try_interval 500ms
		}
	}
}

# The bare domain keeps the path on its way to www, so shared links and the
# ProofPack type URI (https://farbaek.com/proofpack/v1, ADR 0062) land on
# the page they name. Serves once farbaek.com's A record points here
# (docs/deploy/vps.md); until then Caddy just can't get its certificate yet.
farbaek.com {
	redir https://www.farbaek.com{uri} permanent
}

# Farbaek's own Supabase (ADR 0036). Only the two public API paths are
# forwarded; Studio and everything else behind the gateway stay private.
api.farbaek.com {
	@api path /auth/v1/* /rest/v1/*
	handle @api {
		reverse_proxy supabase-gw:8000
	}
	handle {
		respond "Not found" 404
	}
}

# *.farbaek.si with one wildcard certificate, for app previews (p-<id>) and
# published sites alike (ADR 0152). scripts/vps/set-preview-domain.ps1 writes
# extra/previews.caddy from previews.caddy.template, with the Cloudflare
# token, only once that token can answer the DNS challenge. Until then
# nothing matches here and published sites keep the on-demand block below.
import extra/*.caddy

# Every other name: published sites on farbaek.si and people's own domains
# (ADR 0045). The certificate is made on the first visit once the ask above
# says yes; the app then serves only a live site there, and 404 otherwise.
# Previews (p-<id>.farbaek.si) aren't allowed here: they need the wildcard.
https:// {
	tls {
		on_demand
	}
	reverse_proxy app:3000 {
		lb_try_duration 20s
		lb_try_interval 500ms
	}
}
