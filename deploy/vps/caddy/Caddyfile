# Farbaek's front door on the VPS (ADR 0035). Caddy gets and renews each
# certificate itself. The Host header passes through untouched, so
# src/proxy.ts decides what every name serves, exactly as before.
{
	email hello@farbaek.com
	# Published sites and people's own domains get their certificates on
	# first visit (ADR 0045), but only for names Farbaek says are live sites:
	# a live <name>.farbaek.si, or a verified custom domain whose site is live.
	on_demand_tls {
		ask http://app:3000/api/sites/tls-allowed
	}
}

www.farbaek.com, officespace.farbaek.com {
	reverse_proxy app:3000 {
		# While a deploy swaps the app container, hold requests for a moment instead of failing them.
		lb_try_duration 20s
		lb_try_interval 500ms
	}
}

# Farbaek's own Supabase (ADR 0036). Only the two public API paths are
# forwarded; Studio and everything else behind the gateway stay private.
api.farbaek.com {
	@api path /auth/v1/* /rest/v1/*
	handle @api {
		reverse_proxy supabase-gw:8000
	}
	handle {
		respond "Not found" 404
	}
}

# Every other name: published sites on farbaek.si and people's own domains
# (ADR 0045). The certificate is made on the first visit once the ask above
# says yes; the app then serves only a live site there, and 404 otherwise.
# Previews (p-<id>.farbaek.si) aren't allowed here; they wait for the
# wildcard certificate (docs/deploy/vps.md, "farbaek.si").
https:// {
	tls {
		on_demand
	}
	reverse_proxy app:3000 {
		lb_try_duration 20s
		lb_try_interval 500ms
	}
}
